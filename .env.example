# Supabase (Faz 2)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Sunucu tarafı (service role — yalnız güvenli ortamda, asla client'a sızdırma)
SUPABASE_SERVICE_ROLE_KEY=

# Lead bildirimi — talep gelince e-posta (Resend REST API; SDK gerekmez)
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=          # bildirimlerin gideceği adres (sizin kutunuz)
LEAD_FROM_EMAIL=            # gönderen, ör. "DecorPU <bildirim@decorpu.com>" (Resend'de doğrulanmış domain). Boşsa onboarding@resend.dev kullanılır

# Analitik — GA4 ölçüm kimliği (G-XXXXXXX). Yalnız çerez onayı verilirse yüklenir.
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_CLARITY_ID=

# Google Search Console doğrulama (HTML tag yöntemi: content="..." değeri).
# GSC > Mülk ekle > HTML etiketi → tırnak içindeki kodu buraya yapıştır.
GOOGLE_SITE_VERIFICATION=

# Kanonik site adresi. Preview/Vercel'de o domaini yaz (QR linkleri + canonical doğru olsun).
# Boşsa https://decorpu.com kullanılır. Örn: https://decorpu.vercel.app
NEXT_PUBLIC_SITE_URL=

# Arama motoru indexleme. VARSAYILAN KAPALI (noindex) — preview indexlenmez.
# Gerçek domainde yayına alırken "true" yap. Boş/false = noindex.
NEXT_PUBLIC_ALLOW_INDEX=
